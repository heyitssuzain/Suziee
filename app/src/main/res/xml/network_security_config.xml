<?xml version="1.0" encoding="utf-8"?>
<!--
    Network configuration for the online playback engine.

    Media traffic comes from two kinds of endpoints, all of which are HTTPS but may
    hand out HTTP media segment URLs or redirects:
      * googlevideo.com          - YouTube audio, resolved by yt-dlp or the WebView fallback
      * youtube.com / ytimg.com  - yt-dlp metadata and the headless browser session

    Cleartext is permitted so a redirect to an http:// CDN host cannot silently break
    playback. System trust anchors are used for TLS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
