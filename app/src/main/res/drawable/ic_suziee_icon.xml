<?xml version="1.0" encoding="utf-8"?>
<!-- In-app brand mark: the same headphone glyph as the launcher icon, drawn on a
     transparent field so it sits on the header's 40dp accent-gradient badge. The glyph
     is scaled up about its centre so it fills the small 36dp mark without a drop shadow
     (the badge already supplies the colour and depth). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="1.5"
        android:scaleY="1.5"
        android:pivotX="54"
        android:pivotY="55.5">

        <!-- Headband -->
        <path
            android:pathData="M37,54 A17,17 0 0 1 71,54"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="7.2"
            android:strokeLineCap="round" />

        <!-- Headband specular highlight -->
        <path
            android:pathData="M41,50.2 A13,13 0 0 1 67,50.2"
            android:strokeColor="#FFFFFFFF"
            android:strokeAlpha="0.9"
            android:strokeWidth="1.6"
            android:strokeLineCap="round" />

        <!-- Left ear cup -->
        <path android:pathData="M43.75,59.75 v7.5 a6.75,6.75 0 0 1 -13.5,0 v-7.5 a6.75,6.75 0 0 1 13.5,0 z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="37"
                    android:startY="53"
                    android:endX="37"
                    android:endY="74"
                    android:type="linear">
                    <item
                        android:offset="0"
                        android:color="#FFFFFFFF" />
                    <item
                        android:offset="1"
                        android:color="#FFE7D8FF" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Right ear cup -->
        <path android:pathData="M77.75,59.75 v7.5 a6.75,6.75 0 0 1 -13.5,0 v-7.5 a6.75,6.75 0 0 1 13.5,0 z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="71"
                    android:startY="53"
                    android:endX="71"
                    android:endY="74"
                    android:type="linear">
                    <item
                        android:offset="0"
                        android:color="#FFFFFFFF" />
                    <item
                        android:offset="1"
                        android:color="#FFE7D8FF" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Inner wells -->
        <path
            android:fillColor="#FFCDB6F8"
            android:pathData="M40.7,60.5 v6 a3.7,3.7 0 0 1 -7.4,0 v-6 a3.7,3.7 0 0 1 7.4,0 z" />
        <path
            android:fillColor="#FFCDB6F8"
            android:pathData="M74.7,60.5 v6 a3.7,3.7 0 0 1 -7.4,0 v-6 a3.7,3.7 0 0 1 7.4,0 z" />

        <!-- Cup speculars -->
        <path
            android:fillColor="#FFFFFFFF"
            android:fillAlpha="0.9"
            android:pathData="M31,57 a3.6,2.3 0 1 0 7.2,0 a3.6,2.3 0 1 0 -7.2,0 z" />
        <path
            android:fillColor="#FFFFFFFF"
            android:fillAlpha="0.9"
            android:pathData="M65,57 a3.6,2.3 0 1 0 7.2,0 a3.6,2.3 0 1 0 -7.2,0 z" />
    </group>
</vector>
