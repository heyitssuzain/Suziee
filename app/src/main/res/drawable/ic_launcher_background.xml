<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon background: a full-bleed lavender -> pink gradient that bridges the
     Aurora (#A78BFA) and Clay (#D9557B) accents, lifted by a soft top-left light and
     deepened by a faint bottom-right shadow. Both radials fade to full transparency, so
     there are no hard-edged blobs. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Base gradient -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item
                    android:offset="0"
                    android:color="#FFB49BFB" />
                <item
                    android:offset="0.48"
                    android:color="#FFD89BE6" />
                <item
                    android:offset="1"
                    android:color="#FFFF9DC3" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Soft top-left highlight -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="34"
                android:centerY="16"
                android:gradientRadius="74">
                <item
                    android:offset="0"
                    android:color="#38FFFFFF" />
                <item
                    android:offset="1"
                    android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Faint bottom-right depth -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="82"
                android:centerY="98"
                android:gradientRadius="66">
                <item
                    android:offset="0"
                    android:color="#2E7A5AD0" />
                <item
                    android:offset="1"
                    android:color="#007A5AD0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
